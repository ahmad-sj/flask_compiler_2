{% extends "base.jinja" %}

{% block title %} Delete {{ product.name }} {% endblock %}

{% block content %}
<h2>Delete Product: {{ product.name }}</h2>
<p>Are you sure you want to delete this product? This cannot be undone.</p>

<form method="post" action="{{ url_for('delete', product_id=product.id) }}">
    <button type="submit" class="btn">Confirm Delete</button>
    <a href="{{ url_for('detail', product_id=product.id) }}" class="btn">Cancel</a>
</form>
{% endblock %}